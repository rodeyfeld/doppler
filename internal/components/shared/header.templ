package shared

import "doppler/internal/models"

templ Header(user *models.User) {
	<header class="wrap flex h-16 items-center justify-between gap-4 border-b border-line">
		<a class="brand flex items-center gap-2.5" href="/doppler/">
			<span class="mark">
				@Pinwheel("h-6 w-6 shrink-0 text-pin")
			</span>
			<span class="text-[1.15rem] font-medium tracking-[-0.01em]">doppler</span>
		</a>
		<nav class="flex items-center gap-5">
			<a href="/" class="nav-link">pinwheel labs ↗</a>
			if user != nil {
				<button type="button" class="btn btn-primary" onclick="create_post_modal.showModal()">new post</button>
				<details class="menu">
					<summary class="nav-link cursor-pointer">{ user.Username }</summary>
					<div class="menu-panel">
						<a class="menu-item" href="/doppler/profile">profile</a>
						<a class="menu-item" href="/doppler/logout">log out</a>
					</div>
				</details>
			} else {
				<a href="/doppler/login" class="nav-link">log in</a>
			}
		</nav>
	</header>
}
