package shared

import "doppler/internal/models"

templ Layout(title string, user *models.User) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@Head("doppler · "+title, "doppler: posts and photos from pinwheel labs")
			<link rel="stylesheet" href={ templ.SafeURL(Asset("/static/dist/index.css")) }/>
		</head>
		<body class="flex min-h-screen flex-col">
			@Header(user)
			<main class="flex-1 animate-fadeIn">
				{ children... }
			</main>
			<footer class="wrap flex items-center justify-between gap-4 border-t border-line py-6 font-mono text-xs text-mute">
				<span>doppler</span>
				<a href="/" class="quiet-link">all projects ↗</a>
			</footer>
			if user != nil {
				@CreatePostModal()
			}
		</body>
	</html>
}
