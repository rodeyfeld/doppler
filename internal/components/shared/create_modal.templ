package shared

templ CreatePostModal() {
	<dialog id="create_post_modal" class="sheet" aria-labelledby="compose-title">
		<form
			id="create_post_form"
			method="post"
			hx-post="/doppler/create"
			hx-encoding="multipart/form-data"
			hx-target="#form-response"
			hx-swap="innerHTML"
			hx-disabled-elt="find button[type=submit]"
		>
			<div class="flex items-center justify-between border-b border-line px-6 py-4">
				<h2 id="compose-title" class="eyebrow">new post</h2>
				<button type="button" class="nav-link" onclick="create_post_modal.close()">close</button>
			</div>
			<div class="max-h-[70vh] space-y-6 overflow-y-auto px-6 py-6">
				<div id="form-response" class="empty:hidden"></div>
				<input name="title" type="text" class="title-input" placeholder="title" autocomplete="off" required autofocus/>
				<div class="compose-editor">
					<div id="editor"></div>
				</div>
				<div class="field">
					<span class="field-label">photos · up to 5</span>
					<label class="dropzone" data-dropzone>
						<input type="file" name="image-content" accept="image/*" multiple class="sr-only" data-preview="image-preview"/>
						<span>drop photos here, or click to choose</span>
					</label>
					<div id="image-preview" class="hidden grid grid-cols-5 gap-2"></div>
				</div>
			</div>
			<div class="flex items-center justify-end gap-3 border-t border-line px-6 py-4">
				<button type="button" class="btn btn-quiet" onclick="create_post_modal.close()">cancel</button>
				<button type="submit" class="btn btn-primary min-w-[6rem]">
					<span class="htmx-indicator">posting…</span>
					<span class="htmx-not-indicator">post</span>
				</button>
			</div>
		</form>
	</dialog>
}
