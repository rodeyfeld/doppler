package auth

import "doppler/internal/components/shared"

templ SignupForm() {
	<form method="post" action="/doppler/signup" class="flex flex-col gap-6">
		<label class="field">
			<span class="field-label">username</span>
			<input type="text" name="username" class="input" autocomplete="username" autofocus required/>
		</label>
		<label class="field">
			<span class="field-label">email</span>
			<input type="email" name="email" class="input" autocomplete="email" required/>
		</label>
		<label class="field">
			<span class="field-label">password</span>
			<input type="password" name="password" class="input" autocomplete="new-password" required/>
		</label>
		<button class="btn btn-primary btn-block mt-2">sign up</button>
		<p class="text-sm text-mute">
			Already have an account? <a href="/doppler/login" class="link">Log in</a>
		</p>
	</form>
}

templ SignupIndex() {
	@shared.Layout("sign up", nil) {
		@shell("sign up") {
			@SignupForm()
		}
	}
}
