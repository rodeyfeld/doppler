package auth

import (
	"doppler/internal/components/shared"
	"doppler/internal/models"
)

templ Profile(user *models.User) {
	<p class="eyebrow">account</p>
	<h1 class="mt-3 text-3xl font-medium tracking-[-0.02em]">{ user.Username }</h1>
	<dl class="mt-10 border-t border-line">
		@row("username") {
			{ user.Username }
		}
		@row("email") {
			{ user.Email }
		}
		if !user.Created.IsZero() {
			@row("since") {
				<time datetime={ user.Created.UTC().Format("2006-01-02") } class="font-mono text-xs">{ user.Created.UTC().Format("2006-01-02") }</time>
			}
		}
	</dl>
	<div class="mt-10 flex flex-wrap gap-3">
		<a href="/doppler/" class="btn btn-quiet">← posts</a>
		<a href="/doppler/logout" class="btn btn-danger">log out</a>
	</div>
}

templ row(label string) {
	<div class="grid grid-cols-[7rem_1fr] items-baseline gap-4 border-b border-line py-3 text-sm">
		<dt class="eyebrow">{ label }</dt>
		<dd class="truncate text-fg">
			{ children... }
		</dd>
	</div>
}

templ ProfileIndex(user *models.User) {
	@shared.Layout("profile", user) {
		<section class="wrap py-16">
			<div class="max-w-sm">
				@Profile(user)
			</div>
		</section>
	}
}
