package auth

// shell sets a narrow form under a small label and a plain heading.
templ shell(title string) {
	<section class="wrap py-16">
		<div class="max-w-sm">
			<p class="eyebrow">doppler</p>
			<h1 class="mt-3 text-3xl font-medium tracking-[-0.02em]">{ title }</h1>
			<div class="mt-10">
				{ children... }
			</div>
		</div>
	</section>
}
