package auth

import "doppler/internal/components/shared"

templ LoginForm(errorMessage string) {
	<form hx-post="/doppler/login" hx-swap="outerHTML" class="flex flex-col gap-6">
		if errorMessage != "" {
			@shared.ErrorMessage(errorMessage)
		}
		<label class="field">
			<span class="field-label">username</span>
			<input type="text" name="username" class="input" autocomplete="username" autofocus required/>
		</label>
		<label class="field">
			<span class="field-label">password</span>
			<input type="password" name="password" class="input" autocomplete="current-password" required/>
		</label>
		<button class="btn btn-primary btn-block mt-2">log in</button>
		<p class="text-sm text-mute">
			No account? <a href="/doppler/signup" class="link">Sign up</a>
		</p>
	</form>
}

templ LoginIndex() {
	@shared.Layout("log in", nil) {
		@shell("log in") {
			@LoginForm("")
		}
	}
}
