package post

import (
	"doppler/internal/models"
	"fmt"
	"time"
)

templ PostCard(post models.Post) {
	<article class={ "post", waveClass(post.Created) } id={ fmt.Sprintf("post-%d", post.ID) }>
		<p class="flex flex-wrap items-center gap-x-2 font-mono text-xs text-mute" title={ ageLabel(post.Created) }>
			<time data-local="date" datetime={ post.Created.UTC().Format(time.RFC3339) }>
				{ post.Created.UTC().Format("2006-01-02") }
			</time>
			<span>·</span>
			@UserInfo(post.UserID)
		</p>
		<h2 class="post-title mt-3">
			<a href={ templ.SafeURL(fmt.Sprintf("#post-%d", post.ID)) }>{ post.Title }</a>
		</h2>
		if len(post.PictureURLs) > 0 {
			<div class="photos" data-count={ fmt.Sprint(len(post.PictureURLs)) }>
				for idx, picURL := range post.PictureURLs {
					<img
						src={ picURL }
						alt={ fmt.Sprintf("%s, photo %d", post.Title, idx+1) }
						class="photo"
						loading="lazy"
						decoding="async"
					/>
				}
			</div>
		}
		<div class="post-body">
			@templ.Raw(post.Content)
		</div>
	</article>
}
