package post

import (
	"doppler/internal/models"
	"fmt"
)

templ UserInfo(id int) {
	<span
		hx-get={ fmt.Sprintf("/doppler/user-info/%d", id) }
		hx-trigger="load"
		hx-swap="outerHTML"
	></span>
}

templ ListPosts(posts []models.Post) {
	<section class="wrap">
		<h1 class="sr-only">doppler</h1>
		<div id="posts-container">
			for _, post := range posts {
				@PostCard(post)
			}
			<p class="feed-empty py-24 text-center text-dim">no signal yet.</p>
		</div>
	</section>
	<dialog id="image_modal" class="lightbox" aria-label="photo">
		<img id="modal_image" src="" alt="" class="max-h-[94vh] max-w-[96vw] object-contain"/>
	</dialog>
}
