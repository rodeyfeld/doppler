func external(url string) bool {
	return strings.HasPrefix(url, "http")
}

templ Home() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@shared.Head("pinwheel labs", "pinwheel labs: projects by eric rodefeld")
		</head>
		<body class="flex min-h-screen flex-col">
			<div id="tsparticles" class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true"></div>
			<main class="wrap-wide flex-1 pb-16 pt-12 sm:pb-24 sm:pt-24">
				<header class="animate-fadeIn">
					<div class="flex items-center gap-4 sm:gap-6">
						@shared.Pinwheel("pinwheel-slow h-10 w-10 shrink-0 text-pin sm:h-14 sm:w-14")
						<h1 class="text-[2.5rem] font-medium leading-none tracking-[-0.035em] sm:text-7xl">pinwheel labs</h1>
					</div>
					<p class="mt-4 text-lg text-dim sm:mt-5">projects by eric rodefeld</p>
					<p class="mt-5 flex gap-6 font-mono text-xs sm:mt-7">
						<a class="quiet-link" href="https://github.com/rodeyfeld" target="_blank" rel="noopener">github ↗</a>
						<a class="quiet-link" href="https://linkedin.com/in/eric-rodefeld-a0413b188" target="_blank" rel="noopener">linkedin ↗</a>
					</p>
				</header>
				<section class="mt-14 animate-fadeIn stagger-2 sm:mt-20" aria-labelledby="projects-heading">
					<h2 id="projects-heading" class="eyebrow pb-4">projects</h2>
					<ul>
						for _, p := range projects {
							@row(p)
						}
					</ul>
				</section>
			</main>
		</body>
	</html>
}

templ row(p project) {
	<li class={ "project", p.hue }>
		<h3 class="project-name">
			if p.site != "" {
				@projectLink(p.site, p.name)
			} else {
				@projectLink(p.source, p.name)
			}
		</h3>
		<div>
			<p class="text-[15px] leading-relaxed text-dim">{ p.blurb }</p>
			<p class="project-stack">{ strings.Join(p.stack, " · ") }</p>
		</div>
		<p class="project-links">
			if p.site != "" {
				@projectLink(p.site, "visit ↗")
			}
			if p.source != "" {
				@projectLink(p.source, "source ↗")
			}
		</p>
	</li>
}

// projectLink opens other sites in a new tab and keeps doppler in this one.
templ projectLink(url string, label string) {
	<a
		href={ templ.SafeURL(url) }
		if external(url) {
			target="_blank"
			rel="noopener"
		}
	>{ label }</a>
}

templ HomeIndex(title string) {
	@Home()
}
